##TASK 2 – Loops that Count Attempts
def check_attempts(answers, maximum_attempts=3):
    attempts = 0
    index = 0
    success = False
 
    while attempts < maximum_attempts and index < len(answers):
        attempts += 1
        correct = answers[index]
        index += 1
 
        if correct:
            success = True
            maximum_attempts += 2
            print("Security answer correct; two extra attempts granted.")
            break
        else:
            print("Incorrect attempt:", attempts)
 
    if success:
        print("Access verified.")
    else:
        print("Attempt limit reached or no more answers.")
    return attempts, success

##TASK 3 – Vehicle Registration Number Validation
def normalise_registration(reg):
    return reg.strip().upper().replace(" ", "").replace("-", "")
 
def validate_registration(reg):
    value = normalise_registration(reg)
 
    if len(value) < 9 or len(value) > 10:
        return False
 
    # Two state letters and two district digits
    if not value[0:2].isalpha() or not value[2:4].isdigit():
        return False
 
    # One or two series letters followed by four digits
    series_length = len(value) - 8
    if series_length not in (1, 2):
        return False
 
    series = value[4:4 + series_length]
    number = value[4 + series_length:]
 
    return series.isalpha() and len(number) == 4 and number.isdigit()
 
def format_registration(reg):
    value = normalise_registration(reg)
    if not validate_registration(value):
        return "INVALID"
    series_length = len(value) - 8
    return value[:2] + " " + value[2:4] + " " + value[4:4+series_length] + " " + value[-4:]
 
