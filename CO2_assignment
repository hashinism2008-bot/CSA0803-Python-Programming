from time import perf_counter
 
def build_with_plus(parts):
    result = ""
    for part in parts:
        result += part
    return result
 
def build_with_join(parts):
    return "".join(parts)
 
sizes = [1000, 10000, 100000]
for size in sizes:
    parts = [f"item{i}," for i in range(size)]
 
    start = perf_counter()
    text_plus = build_with_plus(parts)
    plus_time = perf_counter() - start
 
    start = perf_counter()
    text_join = build_with_join(parts)
    join_time = perf_counter() - start
 
    print(size, len(text_plus), len(text_join),
          f"plus={plus_time:.6f}s",
          f"join={join_time:.6f}s",
          "same=", text_plus == text_join)

