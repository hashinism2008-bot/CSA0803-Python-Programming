def subsidy_separate_if(units, ration_card, senior_over_80):
    result = "No subsidy"
    if units <= 100:
        result = "Full subsidy"
    if 100 < units <= 200 and ration_card:
        result = "Partial subsidy"
    if units > 200 and senior_over_80:
        result = "Special subsidy"
    return result
 
def subsidy_if_elif(units, ration_card, senior_over_80):
    if units <= 100:
        return "Full subsidy"
    elif units <= 200:
        if ration_card:
            return "Partial subsidy"
        return "No subsidy"
    elif senior_over_80:
        return "Special subsidy"
    else:
        return "No subsidy"
 
