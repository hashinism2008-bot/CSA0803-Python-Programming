##TASK 6 – Recursion and Its Limits: Counting Temple Steps

from functools import lru_cache
 
def ways_recursive(n):
    if n < 0:
        return 0
    if n == 0 or n == 1:
        return 1
    return ways_recursive(n - 1) + ways_recursive(n - 2)
 
@lru_cache(maxsize=None)
def ways_memo(n):
    if n < 0:
        return 0
    if n == 0 or n == 1:
        return 1
    return ways_memo(n - 1) + ways_memo(n - 2)
 
def ways_loop(n):
    if n < 0:
        return 0
    a, b = 1, 1
    for _ in range(n):
        a, b = b, a + b
    return a
 
for n in range(6):
    print(n, ways_recursive(n), ways_memo(n), ways_loop(n))
 
print("For 1000 steps:", ways_loop(1000))

