Q7 – DATA-STRUCTURE DESIGN FROM FIRST PRINCIPLES: CONTACT MERGING 

              
import re
 
contacts = [
    {"name": "Dr. Ravi", "phone": "+91 98400 12345", "email": "ravi@gmail.com"},
    {"name": "ravi kumar", "phone": "9840012345", "email": "ravi.k@gmail.com"},
    {"name": "Meena", "phone": "+91 98765 43210", "email": "meena@gmail.com"},
    {"name": "MEENA", "phone": "9876543210", "email": "meena@gmail.com"},
    {"name": "Arun", "phone": "", "email": "arun@gmail.com"}
]
 
def normalize_phone(phone):
    digits = re.sub(r"\D", "", phone or "")
    if digits.startswith("91") and len(digits) == 12:
        digits = digits[2:]
    return digits
 
def normalize_name(name):
    return " ".join((name or "").lower().split())
 
merged = {}
unmatched = []
 
for contact in contacts:
    phone = normalize_phone(contact.get("phone", ""))
    name = normalize_name(contact.get("name", ""))
    email = (contact.get("email") or "").strip().lower()
 
    if not phone:
        unmatched.append(contact)
        continue
 
    if phone not in merged:
        merged[phone] = {
            "display_name": contact.get("name", "").strip(),
            "normalized_names": set(),
            "phones": set(),
            "emails": set()
        }
 
    if name:
        merged[phone]["normalized_names"].add(name)
    merged[phone]["phones"].add(phone)
    if email:
        merged[phone]["emails"].add(email)
 
for phone, details in merged.items():
    print("Name:", details["display_name"])
    print("Phone numbers:", sorted(details["phones"]))
    print("Emails:", sorted(details["emails"]))
    print()
 
print("Contacts needing manual review:", unmatched)

