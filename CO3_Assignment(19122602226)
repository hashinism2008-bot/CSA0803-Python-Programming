Q3 – DICTIONARIES: FARMER HELPLINE COMPLAINT ANALYSIS 
from collections import Counter
import re
 
calls = [
    {"district": "Salem", "crop": "rice", "text": "seeds not received seeds delayed"},
    {"district": "Erode", "crop": "cotton", "text": "fertiliser price high"},
    {"district": "Salem", "crop": "rice", "text": "seeds price high subsidy not received"},
]
 
STOP = {"not", "the", "is", "a", "and", "to"}
 
word_count = {}
by_district = {}
by_crop = {}
 
for complaint in calls:
    words = re.findall(r"[a-z]+", complaint["text"].lower())
    for word in words:
        if word not in STOP:
            word_count[word] = word_count.get(word, 0) + 1
 
    by_district.setdefault(complaint["district"], []).append(complaint["text"])
    by_crop.setdefault(complaint["crop"], []).append(complaint["text"])
 
top_k = sorted(word_count.items(), key=lambda item: (-item[1], item[0]))[:3]
 
print("Word frequencies:", word_count)
print("Complaints by district:", by_district)
print("Complaints by crop:", by_crop)
print("Top words:", top_k)


